# Public frontend configuration. Never put provider secrets or service-role keys here.
VITE_BANK_ENABLED=false
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server secrets belong in Lovable Cloud / Supabase Edge Function secrets:
# BANK_MODE=disabled (then sandbox after setup; production only after validation)
# APP_ORIGIN=https://your-app.example
# PLUGGY_CLIENT_ID, PLUGGY_CLIENT_SECRET, PLUGGY_CONNECTOR_IDS
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are server-side only.
